// Configuration for ChordPro.

config {
    type: stylemod
    title: "Use HTML5 generator"
    description: "Generate HTML using the new HTML5 backend."
}

// Select HTML5 backend.
html.module: HTML5

// Settings for HTML5 output.
html5 {

    // Optional cover section.
    cover : false

    // Optional front matter section.
    front-matter : false

    // Optional back matter section.
    back-matter : false

    // Output mode. Use `print`/`paged` for the paged HTML5 path
    mode : print

    // HTML5-specific diagram settings.
    diagrams.direction : vertical

    // CSS customization hooks.
    css {
        colors {

            // Colour specification.
            text : ""

            // Colour specification.
            chord : ""

            // Colour specification.
            comment : ""

            // Colour specification.
            highlight : ""

            // Colour specification.
            chorus_bg : ""

            // Colour specification.
            chorus_border : ""
        }
        fonts {
            text  : ""
            chord : ""
            mono  : ""
        }
        sizes {
            text     : ""
            chord    : ""
            title    : ""
            subtitle : ""
            comment  : ""
        }
        spacing {
            line  : ""
            verse : ""
            chord : ""
        }
    }

    // Include paths for templates.
    template_include_path : []

    // Templates for HTML5 generation.
    templates {
        songbook       : html5/songbook.tt
        song           : html5/song.tt
        songline       : html5/songline.tt
        comment        : html5/comment.tt
        image          : html5/image.tt
        chord_diagrams : html5/chord-diagrams.tt
        css            : html5/css/base.tt
    }

    // Settings for paged HTML5 output.
    paged {
        papersize             : null
        margintop             : null
        marginbottom          : null
        marginleft            : null
        marginright           : null
        headspace             : null
        footspace             : null
        song.page-break       : none
        newpage.page-break    : page

        // CSS customization hooks.
        css {
            colors {

                // Colour specification.
                text : ""

                // Colour specification.
                chord : ""

                // Colour specification.
                comment : ""

                // Colour specification.
                highlight : ""

                // Colour specification.
                chorus_bg : ""

                // Colour specification.
                chorus_border : ""
            }
            fonts {
                text  : ""
                chord : ""
                mono  : ""
            }
            sizes {
                text     : ""
                chord    : ""
                title    : ""
                subtitle : ""
                comment  : ""
            }
            spacing {
                line  : ""
                verse : ""
                chord : ""
            }
        }

        // Include paths for templates.
        template_include_path : []

        // Templates for HTML5 generation.
        templates {
            songbook : html5/paged/songbook.tt
            song     : html5/paged/song.tt
            toc      : html5/paged/toc.tt
            css      : html5/paged/css/base.tt
        }
        bundle {
            enabled : false
            mode    : minimal
            html    : null
            css {
                layout  : layout.css
                content : content.css
            }
        }
    }
}

